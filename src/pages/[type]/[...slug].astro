---
// Individual post type entry page (e.g. /blog/my-post).
//
// Static mode (default): getStaticPaths fetches all entries across all post types.
// SSR mode: comment out getStaticPaths and uncomment the SSR block below.

import { devigo, postTypes, pageTitle, siteName } from '../../lib/devigo.js';
import { pickRichText, excerptFrom, extractLeadingHeading } from '../../lib/richtext.js';
import Layout from '../../layouts/Layout.astro';
import RichText from '../../components/RichText.astro';

// ── Static mode ─────────────────────────────────────────────────────────────
export async function getStaticPaths() {
	const paths = [];

	for (const type of postTypes) {
		try {
			const collection = await devigo.posts(type).list();
			for (const entry of collection.data) {
				paths.push({
					params: { type, slug: entry.slug },
					props: { type, entry },
				});
			}
		} catch (error) {
			console.error(`[devigo] Failed to fetch posts for "${type}":`, error);
		}
	}

	return paths;
}

const { entry } = Astro.props;

// ── SSR mode (uncomment this block and remove getStaticPaths above) ─────────
// const { type, slug } = Astro.params;
// const entry = await devigo.posts(type).get(slug);
// ─────────────────────────────────────────────────────────────────────────────

const fv = entry.field_values ?? {};

// Body content — the rich text field, falling back to the markdown/wysiwyg
// fields it replaced. `bodyKey` is kept so the field isn't also rendered by the
// scaffold loop further down.
const { key: bodyKey, html: rawBody } = pickRichText(fv);

// A pasted document that opens with its own H1 carries the real post title in
// that heading. Promote it and drop it from the body, so the page has one H1.
const { title: authoredTitle, html: body } = extractLeadingHeading(rawBody);

// An authored H1 wins, then the entry itself (entry.name); some post types also
// carry the title in a `title`/`text` field. Never fall back to the slug for
// <title> unless there's genuinely nothing else.
const postTitle = (authoredTitle || entry.name || fv.title || fv.text || entry.slug) as string;
const title = pageTitle(postTitle);

// Excerpt/standfirst → meta description. If no excerpt field exists, take the
// opening of the body text as a stopgap.
const excerpt = (fv.excerpt ?? fv.text_1 ?? fv.summary ?? fv.description) as string | undefined;
const description = excerpt || excerptFrom(body);

// Featured image → social share card for this post.
const ogImage = typeof fv.image === 'string' ? fv.image : undefined;

// Article schema so search engines treat posts as articles, not generic pages.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: postTitle,
	...(description && { description }),
	...(entry.published_at && { datePublished: entry.published_at }),
	...(ogImage && { image: ogImage }),
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
	author: {
		'@type': 'Organization',
		name: siteName,
		url: Astro.site?.href,
	},
};
---

<Layout title={title} description={description} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
	<article>
		<h1>{postTitle}</h1>
		<RichText html={body} />

		<!--
			Scaffold: dumps whatever other fields the post type defines, so you can
			see what's available while building the real template. Delete this block
			and render the fields you actually want.

			Values are rendered as *text*, not HTML — only rich text goes through
			set:html, and only after RichText has sanitised it.
		-->
		{Object.entries(fv)
			.filter(([key]) => key !== bodyKey && key !== 'title')
			.map(([key, value]) => (
				<div data-field={key}>
					{typeof value === 'string' ? value : <pre>{JSON.stringify(value, null, 2)}</pre>}
				</div>
			))}
	</article>
</Layout>