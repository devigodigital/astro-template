---
// Post type listing — page 1 (e.g. /blog).
//
// Post types are defined in src/lib/devigo.js — add your slugs there.

import { devigo, postTypes, postsPerPage, pageTitle } from '../../lib/devigo.js';
import Layout from '../../layouts/Layout.astro';
import PostList from './_PostList.astro';

// ── Static mode ─────────────────────────────────────────────────────────────
export async function getStaticPaths() {
	const paths = [];

	// If a CMS page already owns this slug (e.g. a bespoke "blog" page with a
	// posts block), let it win — skip the generic listing so the routes don't
	// collide. Astro prioritises /[type] over /[...slug], which would otherwise
	// shadow the page.
	let cmsSlugs = new Set();
	try {
		cmsSlugs = new Set((await devigo.pages.list()).map((p) => p.slug));
	} catch (error) {
		console.error('[devigo] Failed to fetch pages for listing collision check:', error);
	}

	for (const type of postTypes) {
		if (cmsSlugs.has(type)) continue;

		try {
			const collection = await devigo.posts(type).list({ limit: postsPerPage, offset: 0 });
			const totalPages = Math.ceil(collection.total / postsPerPage);
			paths.push({
				params: { type },
				props: { type, entries: collection.data, totalPages },
			});
		} catch (error) {
			console.error(`[devigo] Failed to fetch posts for "${type}":`, error);
		}
	}

	return paths;
}

const { type, entries, totalPages } = Astro.props;

// This generic listing only renders when no CMS page owns the slug (see the
// collision check above), so there's no CMS title_tag — build one from the type.
const label = type.charAt(0).toUpperCase() + type.slice(1);

// ── SSR mode (uncomment this block and remove getStaticPaths above) ─────────
// const type = Astro.params.type;
// const page = Number(Astro.url.searchParams.get('page') || '1');
// const offset = (page - 1) * postsPerPage;
// const collection = await devigo.posts(type).list({ limit: postsPerPage, offset });
// const entries = collection.data;
// const totalPages = Math.ceil(collection.total / postsPerPage);
// ─────────────────────────────────────────────────────────────────────────────
---

<Layout title={pageTitle(label)}>
	<PostList type={type} entries={entries} page={1} totalPages={totalPages} />
</Layout>
