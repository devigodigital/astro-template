---
// Site header — renders the site logo and the header navigation menu.
// Receives menu items and site settings (logo, company name) from Layout.astro.
// Style the <header>, <nav>, and <ul> as needed.

import MenuItems from './MenuItems.astro';

const { items = [], logo, companyName } = Astro.props;
---

<header style="padding: 16px 24px; border-bottom: 1px solid #777777; display: flex; align-items: center; gap: 24px;">
	<a href="/" aria-label={companyName}>
		{logo
			? <img src={logo} alt={companyName} style="display: block; height: 32px; width: auto;" />
			: <span>{companyName}</span>}
	</a>
	<nav>
		<ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 24px;">
			<MenuItems items={items} />
		</ul>
	</nav>
</header>
