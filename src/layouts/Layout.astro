---
// Base layout — wraps every page.
// Fetches the header/footer menus and site settings from Devigo and passes
// them to the Header and Footer components, then renders the full document
// head: title, meta description, canonical, Open Graph, Twitter and JSON-LD.
//
// Props:
//   title       (required) — the <title>. Build it with pageTitle() from src/lib/devigo.js.
//   description — meta description / og:description / twitter:description.
//   ogImage     — absolute URL of a page-specific share image. Defaults to /og-card.png.
//   ogType      — 'website' (default) or 'article' for posts.
//   noindex     — true on pages that must never be indexed (e.g. 404). Drops the canonical.
//   jsonLd      — an extra schema.org object rendered as ld+json (e.g. BlogPosting).
//   sections    — a CMS page's sections array. Rendered in place of the children;
//                 omit it (or pass an empty array) to render children instead.

import { devigo, getSettings, siteName } from '../lib/devigo.js';
import Header from '../components/menus/Header.astro';
import Footer from '../components/menus/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/main.css';

const { title, description, ogType = 'website', noindex = false, jsonLd, sections } = Astro.props;

// Auto-import every component from src/components so CMS sections can be
// rendered by name — a CMS component called "Test" maps to Test.astro. Drop a
// new .astro file in there and it's immediately available to the CMS; there's
// nothing to register here.
const componentModules = import.meta.glob('../components/*.astro', { eager: true });
const components: Record<string, any> = {};
for (const [path, mod] of Object.entries(componentModules)) {
	components[path.split('/').pop()!.replace('.astro', '')] = (mod as any).default;
}

// Match a CMS component name to a file. Try an exact match first, then fall
// back to a space-stripped name so multi-word display names ("Hero Banner")
// resolve to PascalCase files ("HeroBanner.astro"). "&" becomes "And" and
// remaining non-alphanumerics are stripped, so "Content & Image" resolves to
// "ContentAndImage".
function resolveComponent(name: string) {
	const normalised = name.replace(/&/g, 'And').replace(/[^a-zA-Z0-9]/g, '');
	return components[name] ?? components[name.replace(/\s+/g, '')] ?? components[normalised];
}

// Fail the build rather than shipping a page with an empty <title> — a silent
// undefined here is how a whole site goes live with blank titles.
if (!title) {
	throw new Error(`[Layout] Page "${Astro.url.pathname}" has no title. Pass a title prop (CMS title_tag or a fallback).`);
}

// Social share image — a page/post-specific image (e.g. a post's featured
// image) wins; everything else falls back to the site-wide card in /public.
// Must be an absolute URL: scrapers don't resolve relative og:image paths.
const ogImage = Astro.props.ogImage || new URL('/og-card.png', Astro.site).href;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHomepage = Astro.url.pathname === '/';

// Menus + site settings — these calls run at build time (static) or
// per-request (SSR). Settings provides the logos, company name and number.
const [headerMenu, footerMenu, settings] = await Promise.all([
	devigo.menus.get('header').catch(() => ({ items: [] })),
	devigo.menus.get('footer').catch(() => ({ items: [] })),
	getSettings().catch(() => ({})),
]);

const siteTitle = settings.company_name || siteName;

// Organization schema on the homepage only, built from site settings. Page
// templates can supply their own schema (e.g. BlogPosting) via the jsonLd prop.
const organizationSchema = isHomepage
	? {
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: siteTitle,
			url: Astro.site?.href,
			...(settings.header_logo && { logo: settings.header_logo }),
			sameAs: (footerMenu.items ?? [])
				.map((item) => item.url)
				.filter((url) => typeof url === 'string' && url.startsWith('http')),
		}
	: null;
const schemas = [organizationSchema, jsonLd].filter(Boolean);

// Pass credentials to the client-side tracking script via data attributes.
// These are already public (sent in every API request from the browser).
const trackingConfig = {
	baseUrl: import.meta.env.DEVIGO_API_DOMAIN,
	siteId: import.meta.env.DEVIGO_SITE_ID,
	token: import.meta.env.DEVIGO_API_TOKEN,
};
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<!-- Swap no-js → js before paint so CSS can gate JS-only states
		     (e.g. scroll reveals) without flashing. -->
		<script is:inline>
			document.documentElement.classList.remove('no-js');
			document.documentElement.classList.add('js');
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<!-- Open Graph -->
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage} />

		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Header items={headerMenu.items} logo={settings.header_logo} companyName={siteTitle} />
		<main>
			{sections?.length
				? sections.map((section) => (
						<section>
							{section.rows.map((row) =>
								row.columns.map((col) =>
									col.components.map((comp) => {
										const Component = resolveComponent(comp.component);
										return Component
											? <Component {...(comp.props ?? {})} />
											: <div data-component={comp.component}>Unknown component: {comp.component}</div>
									})
								)
							)}
						</section>
					))
				: <slot />}
		</main>
		<Footer
			items={footerMenu.items}
			logo={settings.footer_logo}
			companyName={siteTitle}
			companyNumber={settings.company_number}
		/>
		<ConsentBanner siteId={trackingConfig.siteId} />

		<script
			is:inline
			data-base-url={trackingConfig.baseUrl}
			data-site-id={trackingConfig.siteId}
			data-token={trackingConfig.token}
		>
			(function () {
				var script = document.currentScript;
				var baseUrl = script.getAttribute('data-base-url').replace(/\/$/, '');
				var siteId = script.getAttribute('data-site-id');
				var token = script.getAttribute('data-token');
				var endpoint = baseUrl + '/api/display/' + siteId + '/track';
				var consentKey = 'devigo_consent_' + siteId;

				function track() {
					if (localStorage.getItem(consentKey) !== 'true') return;

					var params = new URLSearchParams(window.location.search);
					var payload = {
						url: window.location.href,
						referrer: document.referrer || null,
						utm_source: params.get('utm_source') || null,
						utm_medium: params.get('utm_medium') || null,
						utm_campaign: params.get('utm_campaign') || null,
						user_agent: navigator.userAgent,
						screen_width: window.innerWidth,
					};

					fetch(endpoint, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': 'Bearer ' + token,
						},
						body: JSON.stringify(payload),
						keepalive: true,
					}).catch(function () {});
				}

				// Expose for ConsentBanner to call on first accept
				window.__devigoTrack = track;

				// Track initial page load
				track();

				// Track client-side navigation (SPA)
				window.addEventListener('popstate', track);

				var originalPushState = history.pushState;
				history.pushState = function () {
					originalPushState.apply(history, arguments);
					track();
				};

				var originalReplaceState = history.replaceState;
				history.replaceState = function () {
					originalReplaceState.apply(history, arguments);
					track();
				};
			})();
		</script>
	</body>
</html>
